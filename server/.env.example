# Copy to .env and edit
PORT=3000
# 16+ random characters; the admin dashboard and exports require it
ADMIN_TOKEN=change-me-to-a-long-random-string
# SQLite file (created on first run)
DB_PATH=./data/mindseye.sqlite
# Comma-separated allowed origins for the web app, or * (Capacitor iOS sends capacitor://localhost)
CORS_ORIGINS=*
# Set to 1 to also serve ../web as the website at /
SERVE_WEB=1
